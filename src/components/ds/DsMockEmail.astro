---
/**
 * DsMockEmail — mockup de email para eventos. Decorativo (aria-hidden).
 * Variantes:
 *  - 'ai': generador de plantillas con IA en 4 pasos (wizard + preview).
 *  - 'dynamic': contenido dinámico con campos personalizados resaltados.
 * Datos ficticios (Aurora Fest). Props: lang ('es'|'en'|'fr'), variant.
 */
import '../../styles/ds-mock.css';
interface Props { lang?: 'es' | 'en' | 'fr'; variant?: 'ai' | 'dynamic'; }
const { lang = 'es', variant = 'ai' } = Astro.props as Props;

const T = {
  es: {
    aiTag: 'Generado con IA · 4 pasos',
    steps: ['Objetivo', 'Evento', 'Estilo', 'Listo'],
    subject: 'Asunto', subjectVal: 'Aurora Fest: las entradas early bird ya vuelan',
    cta: 'Comprar entradas',
    dynTag: 'Contenido dinámico',
    greet: 'Hola', body1: 'actúa en', body2: 'el 14 jun. Tu código', body3: 'sigue activo.',
    foot: 'Cada fan recibe su versión', variants: '1.240 variantes',
  },
  en: {
    aiTag: 'Generated with AI · 4 steps',
    steps: ['Goal', 'Event', 'Style', 'Ready'],
    subject: 'Subject', subjectVal: 'Aurora Fest: early bird tickets are selling fast',
    cta: 'Get tickets',
    dynTag: 'Dynamic content',
    greet: 'Hi', body1: 'plays', body2: 'on Jun 14. Your code', body3: 'is still live.',
    foot: 'Each fan gets their version', variants: '1,240 variants',
  },
  fr: {
    aiTag: 'Généré avec IA · 4 étapes',
    steps: ['Objectif', 'Évènement', 'Style', 'Prêt'],
    subject: 'Objet', subjectVal: 'Aurora Fest : les billets early bird partent vite',
    cta: 'Prendre mes billets',
    dynTag: 'Contenu dynamique',
    greet: 'Salut', body1: 'joue à', body2: 'le 14 juin. Ton code', body3: 'est toujours actif.',
    foot: 'Chaque fan reçoit sa version', variants: '1 240 variantes',
  },
};
const t = T[lang] ?? T.es;
---

<div class="dsm-grid" aria-hidden="true">
  <div class="dsm-col" style="grid-column: 1 / -1;">
    <div class="dsm-card">

      {variant === 'ai' ? (
        <>
          <div class="em-toprow">
            <span class="em-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>
              {t.aiTag}
            </span>
          </div>
          <div class="em-steps">
            {t.steps.map((s, i) => (
              <span class={`em-step${i === t.steps.length - 1 ? ' em-step--on' : ''}`}>
                <span class="em-step-n">{i + 1}</span>{s}
              </span>
            ))}
          </div>
          <div class="em-preview">
            <div class="em-sub"><span class="em-sub-lbl">{t.subject}</span>{t.subjectVal}</div>
            <div class="em-hero"><span class="em-hero-tag">Aurora Fest</span></div>
            <div class="em-lines"><span></span><span></span><span style="width:72%;"></span></div>
            <div class="em-cta">{t.cta}</div>
          </div>
        </>
      ) : (
        <>
          <div class="em-toprow">
            <span class="em-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M4 8l8 5 8-5"/></svg>
              {t.dynTag}
            </span>
          </div>
          <div class="em-preview">
            <div class="em-hero em-hero--sm"><span class="em-hero-tag">Aurora Fest</span></div>
            <p class="em-copy">
              {t.greet} <span class="em-var">María</span>, <span class="em-var">Lume</span> {t.body1} <span class="em-var">Aurora Fest</span> {t.body2} <span class="em-code">AURORA-24</span> {t.body3}
            </p>
            <div class="em-cta">{t.cta}</div>
          </div>
          <div class="em-foot">
            <span class="em-foot-dot" aria-hidden="true"></span>{t.foot} · <b>{t.variants}</b>
          </div>
        </>
      )}

    </div>
  </div>
</div>

<style>
  .em-toprow { display: flex; margin-bottom: 14px; }
  .em-badge { display: inline-flex; align-items: center; gap: 7px; font-size: 0.74rem; font-weight: 600; color: var(--t-accent); background: var(--t-chip-bg); border-radius: var(--radius-pill); padding: 6px 12px; }
  .em-badge svg { width: 14px; height: 14px; }

  .em-steps { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .em-step { display: inline-flex; align-items: center; gap: 7px; font-size: 0.76rem; font-weight: 600; color: var(--t-muted); border: 1px solid var(--t-border); border-radius: var(--radius-pill); padding: 5px 11px 5px 5px; }
  .em-step--on { color: var(--t-accent); border-color: var(--t-accent); background: var(--t-chip-bg); }
  .em-step-n { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; font-size: 0.66rem; background: color-mix(in srgb, var(--t-muted) 18%, transparent); color: var(--t-text); }
  .em-step--on .em-step-n { background: var(--t-accent); color: var(--t-on-accent); }

  .em-preview { border: 1px solid var(--t-border); border-radius: 12px; padding: 16px; background: var(--t-surface); }
  .em-sub { font-size: 0.82rem; color: var(--t-heading); font-weight: 600; margin-bottom: 14px; line-height: 1.35; }
  .em-sub-lbl { display: block; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--t-muted); font-weight: 700; margin-bottom: 4px; }
  .em-hero { height: 76px; border-radius: 8px; background: linear-gradient(135deg, var(--t-accent), color-mix(in srgb, var(--t-accent) 55%, var(--t-surface))); display: grid; place-items: center; margin-bottom: 14px; }
  .em-hero--sm { height: 56px; margin-bottom: 12px; }
  .em-hero-tag { font-family: var(--ds-font-heading); font-weight: 700; color: var(--t-on-accent); font-size: 1.05rem; letter-spacing: -0.01em; }
  .em-lines { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
  .em-lines span { height: 8px; border-radius: var(--radius-pill); background: color-mix(in srgb, var(--t-muted) 20%, transparent); width: 100%; }
  .em-copy { font-size: 0.86rem; line-height: 1.7; color: var(--t-text); margin: 0 0 14px; }
  .em-var { color: var(--t-accent); font-weight: 600; background: var(--t-chip-bg); border-radius: 5px; padding: 1px 6px; }
  .em-code { font-family: var(--ds-font-heading); font-weight: 700; color: var(--t-heading); border: 1px dashed var(--t-border); border-radius: 5px; padding: 1px 7px; }
  .em-cta { display: inline-block; background: var(--t-accent); color: var(--t-on-accent); font-size: 0.82rem; font-weight: 600; padding: 9px 16px; border-radius: var(--radius-pill); }
  .em-foot { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 0.78rem; color: var(--t-muted); }
  .em-foot b { color: var(--t-heading); }
  .em-foot-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--t-positive); flex-shrink: 0; }
</style>
