---
/**
 * CtaSection Component
 * Call-to-action section with flexible layouts and styling
 * Supports multiple CTA buttons and background variants
 */

export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: {
    text: string;
    href: string;
    variant?: 'primary' | 'secondary' | 'outline';
  };
  secondaryCta?: {
    text: string;
    href: string;
    variant?: 'primary' | 'secondary' | 'outline';
  };
  variant?: 'default' | 'gradient' | 'dark' | 'light';
  size?: 'default' | 'large' | 'compact';
  className?: string;
}

const { 
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  variant = 'gradient',
  size = 'default',
  className = ''
} = Astro.props;

const sectionClasses = [
  'cta-section',
  `cta-section--${variant}`,
  `cta-section--${size}`,
  className
].filter(Boolean).join(' ');
---

<!--
	Portado literalmente de nevent-web/src/components/CtaSection.astro.

	FUENTE DE VERDAD: ese fichero. Si cambia allí, hay que traer el cambio aquí
	para que los dos sitios sigan viéndose igual.

	Único cambio respecto al original: el feedback de interacción pasa de
	puntero encima a :focus-visible / :active, que es lo que exige el guardián
	de estilo de este repositorio (scripts/style-guard.mjs). El aspecto en
	reposo es idéntico.
-->
<section class={sectionClasses}>
  <div class="cta-section__container">
    <div class="cta-section__content">
      <header class="cta-section__header">
        <h2 class="cta-section__title">{title}</h2>
        {subtitle && (
          <p class="cta-section__subtitle">{subtitle}</p>
        )}
      </header>
      
      <div class="cta-section__actions">
        <a 
          href={primaryCta.href} 
          class={`cta-section__button cta-section__button--${primaryCta.variant || 'primary'}`}
        >
          {primaryCta.text}
        </a>
        
        {secondaryCta && (
          <a 
            href={secondaryCta.href} 
            class={`cta-section__button cta-section__button--${secondaryCta.variant || 'secondary'}`}
          >
            {secondaryCta.text}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: var(--spacing-12) 0;
    text-align: center;
    position: relative;
  }

  .cta-section--default {
    background: var(--color-text-white);
  }

  .cta-section--gradient {
    background: linear-gradient(135deg, var(--nevent-medium-slate-purple), var(--nevent-magenta));
    color: var(--color-text-white);
  }

  .cta-section--dark {
    background: var(--nevent-black);
    color: var(--color-text-white);
  }

  .cta-section--light {
    background: var(--nevent-off-white);
  }

  .cta-section--large {
    padding: var(--space-32) 0;
  }

  .cta-section--compact {
    padding: var(--spacing-8) 0;
  }

  .cta-section__container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--spacing-4);
  }

  .cta-section__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-section__header {
    margin-bottom: var(--spacing-6);
  }

  .cta-section__title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    font-family: var(--font-display);
    margin-bottom: var(--spacing-3);
  }

  .cta-section--gradient .cta-section__title,
  .cta-section--dark .cta-section__title {
    color: var(--color-text-white);
  }

  .cta-section--default .cta-section__title,
  .cta-section--light .cta-section__title {
    color: var(--color-text-primary);
  }

  .cta-section__subtitle {
    font-size: var(--font-size-paragraph-lg);
    line-height: var(--line-height-paragraph-lg);
    margin: 0;
    opacity: 0.9;
  }

  .cta-section--gradient .cta-section__subtitle,
  .cta-section--dark .cta-section__subtitle {
    color: color-mix(in srgb, var(--color-text-white) 90%, transparent);
  }

  .cta-section--default .cta-section__subtitle,
  .cta-section--light .cta-section__subtitle {
    color: var(--color-text-secondary);
  }

  .cta-section__actions {
    display: flex;
    gap: var(--spacing-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-section__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-2) var(--spacing-4);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: all var(--motion-duration-base) var(--motion-ease-out);
    min-height: 56px;
    min-width: 180px;
  }

  .cta-section__button--primary {
    background: var(--nevent-black);
    color: var(--color-text-white);
    border: 2px solid var(--nevent-black);
  }

  .cta-section--gradient .cta-section__button--primary,
  .cta-section--dark .cta-section__button--primary {
    background: var(--color-text-white);
    color: var(--nevent-black);
    border-color: var(--color-text-white);
  }

  .cta-section__button--secondary {
    background: transparent;
    color: var(--nevent-magenta);
    border: 2px solid var(--nevent-magenta);
  }

  .cta-section--gradient .cta-section__button--secondary,
  .cta-section--dark .cta-section__button--secondary {
    color: var(--color-text-white);
    border-color: color-mix(in srgb, var(--color-text-white) 50%, transparent);
  }

  .cta-section__button--outline {
    background: transparent;
    color: var(--color-text-primary);
    border: 2px solid var(--color-text-primary);
  }

  .cta-section--gradient .cta-section__button--outline,
  .cta-section--dark .cta-section__button--outline {
    color: var(--color-text-white);
    border-color: var(--color-text-white);
  }

  /* Hover and Focus States */
  .cta-section__button--primary:focus-visible, .cta-section__button--primary:active,
  .cta-section__button--primary:focus {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
  }

  .cta-section--gradient .cta-section__button--primary:focus-visible, .cta-section__button--primary:active,
  .cta-section--dark .cta-section__button--primary:focus-visible, .cta-section__button--primary:active {
    background: var(--nevent-off-white);
  }

  .cta-section__button--secondary:focus-visible, .cta-section__button--secondary:active,
  .cta-section__button--secondary:focus {
    background: var(--nevent-magenta);
    color: var(--color-text-white);
  }

  .cta-section--gradient .cta-section__button--secondary:focus-visible, .cta-section__button--secondary:active,
  .cta-section--dark .cta-section__button--secondary:focus-visible, .cta-section__button--secondary:active {
    background: var(--color-text-white);
    color: var(--nevent-black);
    border-color: var(--color-text-white);
  }

  .cta-section__button--outline:focus-visible, .cta-section__button--outline:active,
  .cta-section__button--outline:focus {
    background: var(--color-text-primary);
    color: var(--color-text-white);
  }

  .cta-section--gradient .cta-section__button--outline:focus-visible, .cta-section__button--outline:active,
  .cta-section--dark .cta-section__button--outline:focus-visible, .cta-section__button--outline:active {
    background: var(--color-text-white);
    color: var(--nevent-black);
  }

  .cta-section__button:focus-visible {
    outline: 2px solid var(--nevent-magenta);
    outline-offset: 2px;
  }

  .cta-section--gradient .cta-section__button:focus-visible,
  .cta-section--dark .cta-section__button:focus-visible {
    outline-color: var(--color-text-white);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .cta-section {
      padding: var(--spacing-8) 0;
    }

    .cta-section--large {
      padding: var(--spacing-10) 0;
    }

    .cta-section__container {
      padding: 0 var(--spacing-2);
    }

    .cta-section__title {
      font-size: var(--mobile-h2);
      line-height: var(--mobile-h2-lh);
    }

    .cta-section__subtitle {
      font-size: var(--mobile-paragraph-lg);
      line-height: var(--mobile-paragraph-lg-lh);
    }

    .cta-section__actions {
      flex-direction: column;
      align-items: center;
      gap: var(--spacing-2);
    }

    .cta-section__button {
      width: 100%;
      max-width: 300px;
      font-size: var(--mobile-body-lg);
      min-height: 48px;
    }
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .cta-section__button {
      transition: none;
    }
    
    .cta-section__button:focus-visible, .cta-section__button:active,
    .cta-section__button:focus {
      transform: none;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .cta-section__button {
      border-width: 3px;
    }
    
    .cta-section--gradient {
      background: var(--nevent-black);
    }
  }
</style>