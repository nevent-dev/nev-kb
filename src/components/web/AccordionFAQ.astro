---
export interface FAQItem {
  id: string;
  question: string;
  answer: string;
  isHTML?: boolean;
}

export interface Props {
  title?: string;
  faqs: FAQItem[];
  variant?: 'default' | 'why-love';
  className?: string;
}

const {
  title = "Frequently asked questions",
  faqs,
  variant = 'default',
  className = ''
} = Astro.props as Props;

const getAccordionClass = () => {
  if (variant === 'why-love') return 'accordion-wrap why-love';
  return 'accordion-wrap';
};

const getAccordionTitleBarClass = () => {
  if (variant === 'why-love') return 'accordion-title-bar why-love';
  return 'accordion-title-bar';
};

const getAccordionTitleClass = () => {
  if (variant === 'why-love') return 'accordion-title light';
  return 'accordion-title';
};

const getAccordionCircleClass = () => {
  if (variant === 'why-love') return 'accordion-circle why-love';
  return 'accordion-circle';
};

const getAccordionTextClass = () => {
  if (variant === 'why-love') return 'accordion-text why-love';
  return 'accordion-text';
};
---

<!--
	Portado literalmente de nevent-web/src/components/AccordionFAQ.astro.

	FUENTE DE VERDAD: ese fichero. Si cambia allí, hay que traer el cambio aquí
	para que los dos sitios sigan viéndose igual.

	Único cambio respecto al original: el feedback de interacción pasa de
	puntero encima a :focus-visible / :active, que es lo que exige el guardián
	de estilo de este repositorio (scripts/style-guard.mjs). El aspecto en
	reposo es idéntico.
-->
<section class={`sections half-tbp ${className}`.trim()}>
  <div class="container">
    <div class="faqs-box">
      <div class="faq-header-box">
        <h2>{title}</h2>
      </div>
      
      <div role="list" class="faq-list">
        {faqs.map((faq) => (
          <div
            role="listitem"
            class="faq-item"
            data-faq-id={faq.id}
          >
              <div class={getAccordionClass()}>
                <a href="#" class={getAccordionTitleBarClass()}>
                  <div class={getAccordionTitleClass()}>{faq.question}</div>
                  <div class={getAccordionCircleClass()}>
                    <div></div>
                  </div>
                </a>
                <div class="accordion-content" style="height: 0px;">
                  {faq.isHTML ? (
                    <div class={`${getAccordionTextClass()} richtext`} set:html={faq.answer}></div>
                  ) : (
                    <p class={getAccordionTextClass()}>{faq.answer}</p>
                  )}
                </div>
              </div>
            </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Typography using tokens */
  h2 {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-bold);
    font-family: var(--font-headings);
    margin: 0 0 var(--spacing-4);
    color: var(--color-text-primary);
  }

  .faqs-box {
    width: 100% !important;
    max-width: 100% !important;
  }

  .faq-header-box {
    text-align: center;
    margin-bottom: var(--spacing-6);
  }

  .faq-list {
    width: 100% !important;
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block !important;
  }

  .faq-item {
    margin-bottom: var(--spacing-2) !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    display: block !important;
    padding: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  .faq-item > * {
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  .accordion-wrap {
    border: 1px solid color-mix(in srgb, var(--color-neutral-300) 35%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--motion-duration-base) var(--motion-ease-in-out);
    width: 100% !important;
    box-sizing: border-box !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .accordion-wrap:focus-visible, .accordion-wrap:active {
    border-color: var(--nevent-magenta);
  }

  .accordion-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-3) var(--spacing-4);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--motion-duration-base) var(--motion-ease-in-out);
  }

  .accordion-title-bar:focus-visible, .accordion-title-bar:active {
    background-color: var(--nevent-off-white);
  }

  .accordion-title {
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .accordion-title.light {
    color: var(--color-text-white);
  }

  .accordion-circle {
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-text-primary);
    border-radius: var(--radius-full);
    position: relative;
    transition: all var(--motion-duration-base) var(--motion-ease-in-out);
  }

  .accordion-circle.why-love {
    border-color: var(--color-text-white);
  }

  .accordion-circle div {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 2px;
    background-color: var(--color-text-primary);
    transition: all var(--motion-duration-base) var(--motion-ease-in-out);
  }

  .accordion-circle.why-love div {
    background-color: var(--color-text-white);
  }

  .accordion-circle div::after {
    content: '';
    position: absolute;
    top: -5px;
    left: 5px;
    width: 2px;
    height: 12px;
    background-color: var(--color-text-primary);
    transition: all var(--motion-duration-base) var(--motion-ease-in-out);
  }

  .accordion-circle.why-love div::after {
    background-color: var(--color-text-white);
  }

  .accordion-wrap.active .accordion-circle div::after {
    transform: rotate(90deg);
  }

  .accordion-content {
    overflow: hidden;
    transition: height var(--motion-duration-base) var(--motion-ease-in-out);
  }

  .accordion-text {
    padding: 0 var(--spacing-4) var(--spacing-3);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .accordion-text.why-love {
    color: var(--color-text-white);
  }

  /* Rich text styles for HTML content */
  .richtext p {
    margin-bottom: var(--spacing-2);
  }

  .richtext ul {
    margin: var(--spacing-2) 0;
    padding-left: var(--spacing-3);
  }

  .richtext li {
    margin-bottom: var(--spacing-1);
  }

  .richtext strong {
    font-weight: var(--font-weight-semibold);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .faqs-box,
    .faq-list,
    .faq-item,
    .faq-item > *,
    .accordion-wrap {
      width: 100% !important;
      max-width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .accordion-title-bar {
      padding: var(--spacing-2) var(--spacing-3);
    }

    .accordion-title {
      font-size: var(--font-size-body);
    }

    .accordion-text {
      padding: 0 var(--spacing-3) var(--spacing-2);
      font-size: var(--font-size-body-sm);
    }
  }
</style>

<script>
  // Accordion functionality
  function initAccordions() {
    const accordionBars = document.querySelectorAll('.accordion-title-bar');
    
    accordionBars.forEach((bar) => {
      bar.addEventListener('click', (e) => {
        e.preventDefault();
        
        const accordionWrap = bar.closest('.accordion-wrap');
        const content = accordionWrap?.querySelector('.accordion-content');
        
        if (!accordionWrap || !content) return;
        
        const isActive = accordionWrap.classList.contains('active');
        
        // Close all other accordions in the same section
        const section = accordionWrap.closest('section');
        const allAccordions = section?.querySelectorAll('.accordion-wrap');
        allAccordions?.forEach((acc) => {
          acc.classList.remove('active');
          const accContent = acc.querySelector('.accordion-content');
          if (accContent) accContent.style.height = '0px';
        });
        
        // Toggle current accordion
        if (!isActive) {
          accordionWrap.classList.add('active');
          content.style.height = `${content.scrollHeight}px`;
        }
      });
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initAccordions);
  
  // Re-initialize if content is dynamically loaded
  document.addEventListener('astro:page-load', initAccordions);
</script>