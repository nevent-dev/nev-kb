---
/**
 * Pie de nevent.ai, portado a la documentación.
 *
 * FUENTE DE VERDAD: nevent-web/src/components/Footer.astro.
 *
 * Tres adaptaciones respecto al original, no es copia literal:
 *  - Los enlaces se absolutizan a nevent.ai. En el original son relativos y
 *    aquí apuntarían a páginas que no existen en help.nevent.ai.
 *  - Se quita el selector de idioma: la documentación ya tiene el suyo en la
 *    cabecera y dos selectores en la misma página se contradicen.
 *  - El feedback pasa de puntero encima a :focus-visible / :active, que es lo
 *    que exige el guardián de estilo de este repositorio.
 */
const SITIO = 'https://nevent.ai';
/**
 * Footer Component
 * 100% Astro native - zero Webflow CSS dependencies
 * Uses 8px spacing system and CSS variables
 */

interface Props {
  lang?: 'es' | 'en' | 'fr';
  currentPath?: string;
}

const { lang = 'en', currentPath = '/' } = Astro.props;
const currentYear = new Date().getFullYear();

// Footer links data structure
const footerData = {
  solutions: {
    title: lang === 'es' ? 'Soluciones' : lang === 'fr' ? 'Solutions' : 'Solutions',
    links: [
      {
        href: `${SITIO}/${lang}${lang === 'es' ? '/soluciones/monetizar-base-datos-festivales' : '/solutions/monetize-festival-database'}`,
        text: lang === 'es' ? 'Monetizar base de datos' : lang === 'fr' ? 'Monétiser la base de données' : 'Monetize database',
        gtmLabel: 'Footer - Monetizar base de datos'
      },
      {
        href: `${SITIO}/${lang}${lang === 'es' ? '/soluciones/segmentar-audiencia-eventos' : '/solutions/segment-event-audience'}`,
