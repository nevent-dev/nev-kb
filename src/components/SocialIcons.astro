---
/**
 * Sustituye los iconos sociales de Starlight por la vuelta al sitio principal.
 *
 * Lo que había era un icono de GitHub apuntando a github.com/nevent/nev-kb,
 * que devuelve 404 (el repositorio real es privado y está en otra
 * organización). Un enlace roto en la cabecera, y además hacia un sitio que a
 * un cliente no le sirve de nada.
 *
 * En su lugar se ofrece el camino de vuelta a nevent.ai, que es lo que hace
 * que las dos propiedades se sientan como una sola.
 */
const esIngles = Astro.url.pathname.startsWith('/en/');
const destino = esIngles ? 'https://nevent.ai/en/' : 'https://nevent.ai/es/';
const etiqueta = esIngles ? 'Go to nevent.ai' : 'Ir a nevent.ai';
---

<a class="volver-al-sitio" href={destino} aria-label={etiqueta}>
	<span>nevent.ai</span>
	<svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
		<path
			d="M7 17 17 7M9 7h8v8"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
</a>

<style>
	.volver-al-sitio {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.4rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 9999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
	}

	.volver-al-sitio:hover {
		border-color: var(--color-purple-500);
		color: var(--color-purple-600);
		background: var(--color-purple-50);
	}

	:root[data-theme='dark'] .volver-al-sitio:hover {
		background: rgb(166 78 255 / 0.14);
		color: var(--sl-color-white);
	}

	/* En móvil la cabecera va justa: el icono basta para no comerse el buscador. */
	@media (max-width: 50rem) {
		.volver-al-sitio span {
			display: none;
		}
		.volver-al-sitio {
			padding: 0.4rem 0.55rem;
		}
	}
</style>
